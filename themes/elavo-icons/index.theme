[Icon Theme]
Name=Elavo
Comment=Elavo icons
Inherits=Adwaita,hicolor
Example=org.gnome.Nautilus
Directories=16x16/apps,16x16/places,22x22/apps,22x22/places,24x24/apps,24x24/places,32x32/apps,32x32/places,48x48/apps,48x48/places,56x56/apps,56x56/places,64x64/apps,64x64/places,128x128/apps,128x128/places,256x256/apps,256x256/places,512x512/apps,512x512/places,symbolic/apps,symbolic/actions

# Exported from the 1024px masters in assets/icons/1024. GTK loads the
# nearest of these instead of scaling a 1024px file. 56 is the dock's
# stack size. The symbolic icons stay as SVG.

[16x16/apps]
Size=16
Type=Fixed
Context=Applications

[16x16/places]
Size=16
Type=Fixed
Context=Places

[22x22/apps]
Size=22
Type=Fixed
Context=Applications

[22x22/places]
Size=22
Type=Fixed
Context=Places

[24x24/apps]
Size=24
Type=Fixed
Context=Applications

[24x24/places]
Size=24
Type=Fixed
Context=Places

