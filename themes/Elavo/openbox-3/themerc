# Elavo server-side decorations for labwc.
#
# Button art is the PNGs from assets/ui/window-decorations, copied here so the
# theme directory installs as one piece. labwc loads the names it knows
# (close-active.png, iconify_hover-inactive.png, max_toggled-active.png,
# and so on), which are symlinks to those PNGs. An unfocused window shows
# close-defocused-500px.png on every button; hovering one shows its hover
# art. labwc lights only the button under the pointer.
#
# A server-side bar holds only the buttons and the title, so it matches
# client-side title-only bars: 30px tall, with 16px buttons 7px from the
# top and 8px inside the 1px border.
# labwc's bar is the title font's 20px plus the vertical padding on each
# side. The title text is still open. The window tokens below are written
# from $elavo-window-radius by build.sh. The mods layer reads them, and
# they win over rc.xml.

window.button.width: 16
window.button.height: 16
window.button.spacing: 8
window.titlebar.padding.width: 8
window.titlebar.padding.height: 5

# labwc draws one shadow layer. These are the only shadow values the
# compositor uses: the mods layer builds the shadow on maximized windows,
# including ones that draw their own title bar, from the same pieces.
window.active.shadow.size: 24
window.active.shadow.color: #00000026
window.inactive.shadow.size: 16
window.inactive.shadow.color: #00000014

# elavo-window-tokens
window.cornerRadius: 12
window.maximizedCorners: yes
window.dropShadows: yes
window.dropShadowsOnTiled: yes
window.dropShadowsOnMaximized: yes
window.blur.strength: 3
